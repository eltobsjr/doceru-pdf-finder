{
  "manifest_version": 3,
  "name": "Doceru PDF Finder",
  "version": "1.0.0",
  "description": "Captura o valor de data-pdf-url nas páginas do doceru.com e mostra no popup da extensão.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://doceru.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Doceru PDF Finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://doceru.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
